      "title": "HTTP Traffic & Performance",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 5,
      "title": "HTTP Request Rate by Service (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 6,
      "title": "HTTP Response Latency Max (Seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (application) (http_server_requests_seconds_max)",
          "legendFormat": "{{application}} (Max Latency)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 7,
      "title": "HTTP Error Rate (5xx Server Errors)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
          "legendFormat": "{{application}} 5xx Errors",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 8,
      "title": "Kafka Consumer Lag by Topic",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (topic) (kafka_consumer_fetch_manager_records_lag) or vector(0)",
          "legendFormat": "Lag: {{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 102,
      "title": "JVM Resources (Memory & CPU)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "id": 9,
      "title": "JVM Heap Memory Usage (%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(sum by (application) (jvm_memory_used_bytes{area=\"heap\"}) / sum by (application) (jvm_memory_max_bytes{area=\"heap\"})) * 100",
          "legendFormat": "{{application}} Heap %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "id": 10,
      "title": "Process CPU Usage (%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "process_cpu_usage * 100",
          "legendFormat": "{{application}} CPU %",
          "refId": "A"
        }
      ]
    }
  ],
