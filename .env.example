# =============================================================================
# Distributed E-Commerce Microservices - Environment Configuration Template
# =============================================================================
# DO NOT commit real secrets (.env) to version control.
# Copy this file to .env and provide your deployment-specific credentials.

# Databases
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
MONGODB_USER=mongo
MONGODB_PASSWORD=your_secure_mongo_password_here

# Security & JWT
# Must be at least 256 bits (32 bytes) for HMAC-SHA256
JWT_SECRET=your_32_byte_minimum_secure_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Infrastructure URLs
EUREKA_SERVER_URL=http://localhost:8761/eureka/
CONFIG_SERVER_URL=http://localhost:8888
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_secure_grafana_password_here
